# ─────────────────────────────────────────────────────────────────────────────
# Lanners & Jager – Umgebungsvariablen
# Kopieren nach .env (lokal) bzw. als GitHub-Secrets / Supabase-Secrets setzen.
# Werte mit PUBLIC_ landen im statischen HTML. Alles andere nie im Frontend.
# ─────────────────────────────────────────────────────────────────────────────

# ── Website (Build) ──────────────────────────────────────────────────────────
# Domain fehlt noch (OP-02.3). Auch die Functions brauchen SITE_URL (CORS, Weiterleitungen).
SITE_URL=http://127.0.0.1:4321
# Nur für GitHub Pages ohne eigene Domain, z. B. /lanners-jager
BASE_PATH=
# Demo-Modus: Demo-Leiste, noindex, Demo-Postausgang, Demo-Artikel erlaubt
PUBLIC_DEMO=true
# Die drei Wege (D10.1). Nach der Demo entscheidet der Kunde.
PUBLIC_FEATURE_RESERVE=true
PUBLIC_FEATURE_PAY_COLLECT=true
PUBLIC_FEATURE_PAY_SHIP=true
# Satz "Hoflieferant" (Freigabe fehlt, OP-09)
PUBLIC_FEATURE_HOFLIEFERANT=false
# Basis der Edge Functions. Lokal: npm run dev:api; Supabase: https://<ref>.supabase.co/functions/v1
PUBLIC_FUNCTIONS_URL=http://127.0.0.1:54331/functions/v1

# Datenquelle des Builds: fixtures (lokal) oder api (Supabase über catalog-export)
CATALOG_SOURCE=fixtures
# Nur für CATALOG_SOURCE=api: Geheimnis für catalog-export (GitHub-Secret + Supabase-Secret)
BUILD_SECRET=
# Für Produktfotos aus dem Storage (Produktion)
SUPABASE_URL=

# ── Edge Functions (Supabase-Secrets; lokal liest dev:api diese Datei) ───────
# mock = Fixtures, http = echte SoftTouch-API
SOFTTOUCH_MODE=mock
# 0 bis 1: Anteil der Mock-Aufrufe, die mit HTTP 500 scheitern (Outbox testen)
MOCK_FAIL_RATE=0
# Konto und Token je Haus. Zeigen beide auf dasselbe Konto, wird es nur einmal abgefragt.
ST_ACCOUNT_LANNERS=
ST_TOKEN_LANNERS=
ST_ACCOUNT_JAGER=
ST_TOKEN_JAGER=
# Filial-IDs je Haus, kommagetrennt (OP-04.3). Demo: 01 und 02
ST_STORES_LANNERS=01
ST_STORES_JAGER=02
# POS für Web-Reservierungen je Haus (OP-04.11), leer = Standard des Kontos
ST_POS_LANNERS=
ST_POS_JAGER=
# Online-Kanal (OP-04.4)
ST_ONLINE_CHANNEL=1
# Foto-Server der Häuser (OP-04.5)
ST_PHOTO_BASE_URL=

# Mails: log = nur in mail_log (Demo-Postausgang), smtp = verschicken (EU-Anbieter, OP-02.4)
MAIL_MODE=log
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Empfänger (OP-02.4). In der Demo bewusst keine echten Adressen.
MAIL_TO_LANNERS=lanners@demo.invalid
MAIL_TO_JAGER=jager@demo.invalid
ALERT_RECIPIENT=alarm@demo.invalid

# Zahlung: mock (Demo-Seite) oder mollie (Testmodus mit Testschlüsseln)
PAYMENT_PROVIDER=mock
PAY_KEY_LANNERS=
PAY_KEY_JAGER=

# Geheimnisse (lange Zufallswerte, z. B. openssl rand -hex 32)
ORDER_TOKEN_SECRET=dev-order-token-secret-change-me
RATE_LIMIT_SALT=dev-rate-limit-salt-change-me
CRON_SECRET=dev-cron-secret-change-me
ORDER_READY_SECRET=dev-order-ready-secret-change-me

# Rebuild über repository_dispatch (Fine-Grained-Token nur für dieses Repository)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=
