---
/**
 * "/" leitet auf die Standardsprache Luxemburgisch weiter (Briefing A, x-default = lb).
 * GitHub Pages kann keine Server-Weiterleitung: Meta-Refresh plus Link.
 */
import { SITE_URL } from "../config/site.ts";
import { href } from "../lib/page.ts";
const target = href("/lb/");
---
<!doctype html>
<html lang="lb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lanners &amp; Jager</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={SITE_URL + target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + target} />
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 24px">
    <p><a href={target}>Lanners &amp; Jager</a></p>
  </body>
</html>
