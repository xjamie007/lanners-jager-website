---
/** So funktioniert's (D8, E3): die drei Wege ausführlich, dazu die passenden Fragen. */
import Page from "../layouts/Page.astro";
import Steps from "../components/Steps.astro";
import Faq from "../components/Faq.astro";
import Offen from "../components/Offen.astro";
import { features, buyEnabled } from "../config/site.ts";
import { shop } from "../config/shop.ts";
import { versand } from "../config/versand.ts";
import { t, type Lang } from "../i18n/index.ts";
import { faqJsonLd } from "../lib/seo.ts";
import { formatPrice } from "@shared/format.ts";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const n = shop.reservierung.haltedauerTage;
const land = versand.laender[0];
const faqIds = [1, 2, 3, 4, 5, 6, 7];
const faqData = faqIds
  .filter((i) => i !== 4)
  .filter((i) => (i === 5 ? features.payShip : true))
  .map((i) => ({ q: t(lang, `faq.q${i}`), a: t(lang, `faq.a${i}`, { n }) }));
---
<Page suchbar lang={lang} route="howto" section="service" foto="anprobe-spiegel" fotoPosition="70% 45%" h1={t(lang, "howto.h1")} intro={t(lang, "howto.intro")} title={t(lang, "seo.howto.title")} description={t(lang, "seo.howto.desc")} jsonLd={[faqJsonLd(faqData)]}>
  <h2 class="t-h2" id="howto-schritte">{t(lang, "howto.schritteH2")}</h2>
  <Steps lang={lang} />

  {
    features.reserve && (
      <>
        <h2 class="t-h2" id="howto-reservieren">{t(lang, "howto.reservierenH2")}</h2>
        <div class="prosa">
          <p>
            {t(lang, "howto.reservierenText", { n })} <Offen op="OP-05.1" lang={lang} />
          </p>
          <p>
            {t(lang, "howto.reservierenFrei")} <Offen op="OP-05.5" lang={lang} />
          </p>
        </div>
      </>
    )
  }
  {
    features.payCollect && (
      <>
        <h2 class="t-h2" id="howto-abholen">{t(lang, "howto.abholenH2")}</h2>
        <div class="prosa">
          <p>
            {t(lang, "howto.abholenText")} <Offen op="OP-06.6" lang={lang} />
          </p>
          <p>
            {t(lang, "howto.anderesHaus")} <Offen op="OP-05.2" lang={lang} />
          </p>
        </div>
      </>
    )
  }
  {
    features.payShip && land && (
      <>
        <h2 class="t-h2" id="howto-liefern">{t(lang, "howto.liefernH2")}</h2>
        <div class="prosa">
          <p>
            {t(lang, "howto.liefernText", { n: land.lieferzeitTage, kosten: formatPrice(land.kostenCent, lang) })}
            {land.demoWert && <span class="nebentext"> ({t(lang, "demo.wert")})</span>} <Offen op="OP-06.2" lang={lang} />
          </p>
        </div>
      </>
    )
  }
  {
    buyEnabled && (
      <>
        <h2 class="t-h2" id="howto-bezahlen">{t(lang, "howto.bezahlenH2")}</h2>
        <div class="prosa">
          <p>{t(lang, "howto.bezahlenText")}</p>
        </div>
      </>
    )
  }
  <h2 class="t-h2" id="howto-rueckgabe">{t(lang, "howto.rueckgabeH2")}</h2>
  <div class="prosa">
    {buyEnabled && <p>{t(lang, "howto.rueckgabeText")}</p>}
    <p>
      {t(lang, "howto.umtausch")} <Offen op="OP-06.4" lang={lang} />
    </p>
  </div>

  <h2 class="t-h2" id="howto-faq">{t(lang, "howto.faqH2")}</h2>
  <Faq lang={lang} ids={faqIds} headingId="howto-faq" />
</Page>
