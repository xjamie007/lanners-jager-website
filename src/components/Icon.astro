<svg
  class={`icon ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"><path d={paths[name]} vector-effect="non-scaling-stroke"></path></svg>
