---
/**
 * Stimmungsfoto aus src/assets/fotos/ (Unsplash-Lizenz, Nachweis im Impressum,
 * siehe src/content/bildnachweis.json). Astro rechnet es in WebP in passenden
 * Breiten. Fehlt die Datei, steht eine Fläche im Hausverlauf an ihrer Stelle.
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

const bilder = import.meta.glob<{ default: ImageMetadata }>("../assets/fotos/*.{jpg,jpeg,png,webp}", { eager: true });

interface Props {
  name: string;
  /** leer = dekorativ */
  alt: string;
  sizes: string;
  class?: string;
  eager?: boolean;
  /** Ausschnitt, z. B. "center 30%" */
  position?: string;
}
const { name, alt, sizes, class: cls = "", eager = false, position } = Astro.props;
const key = Object.keys(bilder).find((k) => k.split("/").pop()!.replace(/\.\w+$/, "") === name);
const img = key ? bilder[key].default : null;
const widths = img ? [480, 800, 1200, 1600, 2000].filter((w) => w <= img.width) : [];
if (img && !widths.includes(img.width) && img.width < 2000) widths.push(img.width);
---
{
  img ? (
    <Picture
      src={img}
      alt={alt}
      formats={["webp"]}
      widths={widths}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      class={`foto ${cls}`}
      style={position ? `object-position:${position}` : undefined}
      pictureAttributes={{ style: "display:contents" }}
    />
  ) : (
    <span class={`foto foto-fehlt ${cls}`} role={alt ? "img" : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : "true"} />
  )
}

<style is:global>
  .foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .foto-fehlt {
    background: var(--haus-verlauf);
  }
</style>
