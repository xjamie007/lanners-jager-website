---
/**
 * Häufige Fragen (E5) als <details>. Fragen mit offenen Antworten tragen einen
 * sichtbaren Platzhalter und gehen nicht in die strukturierten Daten.
 * Frage 5 (Lieferung) nur mit payShip.
 */
import { features, buyEnabled } from "../config/site.ts";
import { shop } from "../config/shop.ts";
import { t, type Lang } from "../i18n/index.ts";
import { link } from "../lib/page.ts";
import Offen from "./Offen.astro";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
  ids?: number[];
  headingId: string;
}
const { lang, ids = [1, 2, 3, 4, 5, 6, 7, 9, 10], headingId } = Astro.props;
const n = shop.reservierung.haltedauerTage;
const op: Record<number, string> = { 2: "OP-05.5", 3: "OP-05.1", 4: "OP-05.2", 5: "OP-06.2", 9: "OP-14", 10: "OP-15" };
const visible = ids.filter((i) => (i === 5 ? features.payShip : true)).filter((i) => (i === 2 || i === 3 || i === 4 ? features.reserve : true));
---
<div class="faq" aria-labelledby={headingId}>
  {
    visible.map((i, nr) => (
      <details class="faq-eintrag">
        <summary>
          <span class="faq-nr" aria-hidden="true">{String(nr + 1).padStart(2, "0")}</span>
          <span class="faq-frage">{t(lang, `faq.q${i}`)}</span>
          <span class="faq-knopf" aria-hidden="true">
            <Icon name="plus" size={20} />
          </span>
        </summary>
        <div class="aufklapp">
          <div class="aufklapp-innen prosa">
            <p>
              {t(lang, `faq.a${i}`, { n })}
              {op[i] && <Offen op={op[i]} lang={lang} />}
              {i === 6 && (
                <>
                  {" "}
                  {t(lang, "faq.a6Umtausch")} <Offen op="OP-06.4" lang={lang} />
                </>
              )}
            </p>
            {i === 6 && buyEnabled && (
              <p>
                <a href={link(lang, "widerruf")}>{t(lang, "footer.widerruf")}</a>
              </p>
            )}
          </div>
        </div>
      </details>
    ))
  }
</div>

<script>
  // Auf- und Zuklappen mit Höhenanimation. Ohne JavaScript oder mit „Bewegung
  // reduzieren“ klappt <details> wie gewohnt sofort auf.
  const ruhig = matchMedia("(prefers-reduced-motion: reduce)");
  const DAUER = 340;
  const KURVE = "cubic-bezier(0.2, 0.7, 0.2, 1)";

  for (const faq of document.querySelectorAll(".faq")) faq.classList.add("mit-js");
  for (const d of document.querySelectorAll<HTMLDetailsElement>(".faq-eintrag")) {
    const summary = d.querySelector("summary");
    const koerper = d.querySelector<HTMLElement>(".aufklapp");
    if (!summary || !koerper) continue;
    let lauf: Animation | null = null;

    const animieren = (von: number, bis: number, oeffnen: boolean) => {
      lauf?.cancel();
      d.classList.toggle("ist-offen", oeffnen);
      lauf = koerper.animate(
        [
          { height: `${von}px`, opacity: oeffnen ? 0 : 1 },
          { height: `${bis}px`, opacity: oeffnen ? 1 : 0 },
        ],
        { duration: DAUER, easing: KURVE },
      );
      lauf.onfinish = () => {
        lauf = null;
        if (!oeffnen) d.open = false;
      };
    };

    summary.addEventListener("click", (e) => {
      if (ruhig.matches) {
        d.classList.toggle("ist-offen", !d.open);
        return;
      }
      e.preventDefault();
      const jetzt = koerper.getBoundingClientRect().height;
      if (!d.open || (lauf && !d.classList.contains("ist-offen"))) {
        d.open = true;
        animieren(lauf ? jetzt : 0, koerper.scrollHeight, true);
      } else {
        animieren(jetzt, 0, false);
      }
    });
    // Öffnen ohne Klick (Suche im Browser, Sprunglink) hält den Zustand gleich
    d.addEventListener("toggle", () => {
      if (!lauf) d.classList.toggle("ist-offen", d.open);
    });
  }
</script>

<style>
  .faq {
    max-width: 860px;
    display: grid;
    gap: 10px;
  }
  .faq-eintrag {
    background: var(--color-glas);
    border-radius: var(--radius-bild);
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      background-color 260ms ease,
      box-shadow 260ms ease;
  }
  .faq-eintrag:hover {
    background: #e9ebef;
  }
  .faq-eintrag.ist-offen,
  .faq:not(.mit-js) .faq-eintrag[open] {
    background: var(--color-weiss);
    box-shadow: inset 0 0 0 1.5px var(--color-marine);
  }
  summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    min-height: 64px;
    padding: 14px 16px 14px 22px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-bild);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid var(--color-marine);
    outline-offset: 2px;
  }
  .faq-nr {
    font-family: var(--font-display, "League Gothic", sans-serif);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-schiefer);
    min-width: 2ch;
    transition: color 260ms ease;
  }
  .ist-offen .faq-nr,
  .faq:not(.mit-js) [open] .faq-nr {
    color: var(--color-marine);
  }
  .faq-frage {
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.4;
  }
  .faq-knopf {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-weiss);
    color: var(--color-tusche);
    transition:
      background-color 260ms ease,
      color 260ms ease,
      transform 340ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .faq-eintrag.ist-offen .faq-knopf,
  .faq:not(.mit-js) [open] .faq-knopf {
    background: var(--color-marine);
    color: var(--color-weiss);
    transform: rotate(135deg);
  }
  .faq-eintrag.ist-offen:hover {
    background: var(--color-weiss);
  }
  .aufklapp {
    overflow: hidden;
  }
  .aufklapp-innen {
    padding: 0 70px 22px calc(22px + 2ch + 18px);
    color: var(--color-tusche);
    max-width: 72ch;
  }
  .aufklapp-innen :global(p + p) {
    margin-top: 10px;
  }
  @media (max-width: 600px) {
    summary {
      gap: 12px;
      padding: 12px 12px 12px 16px;
    }
    .faq-nr {
      font-size: 1.25rem;
    }
    .faq-frage {
      font-size: 1rem;
    }
    .faq-knopf {
      width: 34px;
      height: 34px;
    }
    .aufklapp-innen {
      padding: 0 16px 18px 16px;
    }
  }
</style>
