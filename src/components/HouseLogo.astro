---
/**
 * Logos der zwei Häuser.
 * - Jager-Oberlinkels: die echte Gebäudezeichnung aus dem Logo (Letzshop-Datei,
 *   freigestellt in public/logos/, dunkel und weiß), darunter der Schriftzug
 *   "JAGER-OBERLINKELS" zwischen zwei Linien und "Chapellerie · Chemiserie"
 *   wie auf dem Gutschein.
 * - Confection Lanners: Schriftzug wie auf dem Gutschein nachgesetzt
 *   ("Confection" / LANNERS / "Ettelbruck"); eine Vektordatei fehlt (OP-02.2).
 * `hell`: weiß, für Fotos und Verläufe. `bild={false}`: Jager ohne Gebäude.
 */
import { asset } from "../lib/page.ts";
import { getHouse } from "../config/houses.ts";
interface Props {
  haus: "lanners" | "jager";
  hell?: boolean;
  bild?: boolean;
  class?: string;
}
const { haus, hell = false, bild = true, class: cls = "" } = Astro.props;
const h = getHouse(haus);
---
<span class={`hauslogo hauslogo-${haus} ${hell ? "hauslogo-hell" : ""} ${cls}`} role="img" aria-label={h.name}>
  {
    haus === "lanners" ? (
      <span class="hl-lanners" aria-hidden="true">
        <span class="hl-zeile-klein">Confection</span>
        <span class="hl-lanners-gross">Lanners</span>
        <span class="hl-zeile-klein">Ettelbruck</span>
      </span>
    ) : (
      <span class="hl-jager" aria-hidden="true">
        {bild && <img class="hl-gebaeude" src={asset(hell ? "logos/jager-gebaeude-hell.webp" : "logos/jager-gebaeude.webp")} alt="" width="609" height="592" loading="lazy" decoding="async" />}
        <span class="hl-jager-wort">Jager-Oberlinkels</span>
        <span class="hl-jager-zusatz">Chapellerie · Chemiserie</span>
      </span>
    )
  }
</span>

<style is:global>
  .hauslogo {
    display: inline-flex;
    color: var(--color-marine);
    line-height: 1;
  }
  .hauslogo-jager {
    color: var(--color-jager);
    width: 14em;
    max-width: 100%;
  }
  .hauslogo-hell {
    color: var(--color-weiss);
  }
  /* Lanners: schmale fette Versalien, darüber und darunter weit gesperrt */
  .hl-lanners {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }
  .hl-lanners-gross {
    font-family: var(--font-display);
    font-size: 3.25em;
    line-height: 0.92;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    -webkit-text-stroke: 0.025em currentColor;
  }
  .hl-zeile-klein {
    font-size: 0.8em;
    font-weight: 600;
    letter-spacing: 0.24em;
    padding-left: 0.24em;
  }
  .hl-lanners .hl-zeile-klein:first-child {
    margin-bottom: 0.15em;
  }
  .hl-lanners .hl-zeile-klein:last-child {
    margin-top: 0.2em;
  }
  /* Jager: Gebäude, Schriftzug zwischen zwei Linien, Zusatz rechts */
  .hl-jager {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
  }
  .hl-gebaeude {
    display: block;
    width: 62%;
    height: auto;
    margin: 0 auto 0.5em;
  }
  .hl-jager-wort {
    padding: 0.42em 0;
    border-block: 1px solid currentColor;
    font-size: 1.05em;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hl-jager-zusatz {
    margin-top: 0.35em;
    font-size: 0.68em;
    letter-spacing: 0.08em;
    text-align: right;
    opacity: 0.85;
  }
</style>
