---
/**
 * Filter und Sortierung einer Listenseite (D3). Statisch gerendert, aber nur mit
 * JavaScript sichtbar (ohne JavaScript gibt es keine Filter, nur die Seiten).
 * Mobil öffnet "Filtern" einen <dialog>; ab 1024 px setzt src/scripts/filter.ts
 * dasselbe Formular als Zeile mit aufklappbaren Feldern über das Raster.
 * Das Haus filtert der Hausschalter (C3); er ist überall sichtbar.
 */
import Icon from "./Icon.astro";
import { t, tp, type Lang } from "../i18n/index.ts";
import type { Facetten } from "../lib/filterindex.ts";

interface Props {
  lang: Lang;
  facetten: Facetten;
  listeDatei: string;
  gesamt: number;
}
const { lang, facetten: fc, listeDatei, gesamt } = Astro.props;
// Ein Filter mit nur einem Wert hilft nicht weiter
const gruppen = [
  { name: "marke", label: t(lang, "liste.marke"), werte: fc.marken },
  { name: "groesse", label: t(lang, "liste.groesse"), werte: fc.groessen },
  { name: "farbe", label: t(lang, "liste.farbe"), werte: fc.farben },
  { name: "preis", label: t(lang, "liste.preis"), werte: fc.preise },
].filter((g) => g.werte.length > 1);
const sortierungen = [
  { value: "", label: t(lang, "liste.sortEmpfohlen") },
  { value: "neu", label: t(lang, "liste.sortNeu") },
  { value: "preis-auf", label: t(lang, "liste.sortPreisAuf") },
  { value: "preis-ab", label: t(lang, "liste.sortPreisAb") },
];
---
<div class="filter nur-js" data-filter data-liste-datei={listeDatei}>
  <div class="filter-leiste">
    <button type="button" class="btn btn-sekundaer filter-oeffnen" data-filter-oeffnen aria-haspopup="dialog" aria-controls="filter-dialog">
      {t(lang, "liste.filtern")}<span data-filter-zahl></span>
    </button>
    <div class="filter-inline" data-filter-inline></div>
    <label class="filter-sort">
      <span class="filter-sort-label">{t(lang, "liste.sortieren")}</span>
      <select class="feld filter-select" name="sortierung" data-filter-sort>
        {sortierungen.map((s) => <option value={s.value}>{s.label}</option>)}
      </select>
    </label>
  </div>

  <dialog class="filter-dialog" id="filter-dialog" data-filter-dialog aria-labelledby="filter-titel">
    <div class="filter-dialog-kopf">
      <h2 id="filter-titel" class="t-h3">{t(lang, "liste.filterTitel")}</h2>
      <button type="button" class="filter-zu" data-filter-zu>
        <Icon name="schliessen" />
        <span class="sr-only">{t(lang, "nav.schliessen")}</span>
      </button>
    </div>
    <form class="filter-form" data-filter-form>
      {
        gruppen.map((g) => (
          <details class="filter-feld" data-filter-feld>
            <summary class="filter-feld-kopf">
              <span>
                {g.label}
                <span data-feld-zahl />
              </span>
              <Icon name="plus" size={18} class="filter-auf" />
              <Icon name="minus" size={18} class="filter-zu-icon" />
            </summary>
            <fieldset class="filter-werte" data-name={g.name}>
              <legend class="sr-only">{g.label}</legend>
              {g.werte.map((w) => (
                <label class="auswahl filter-wert">
                  <input type="checkbox" name={g.name} value={w.id} />
                  <span>{w.name}</span>
                </label>
              ))}
            </fieldset>
          </details>
        ))
      }
      {
        fc.sale && (
          <label class="auswahl filter-sale">
            <input type="checkbox" name="sale" value="1" />
            <span>{t(lang, "liste.nurSale")}</span>
          </label>
        )
      }
      <button type="button" class="linkbutton filter-reset" data-filter-reset hidden>{t(lang, "liste.zuruecksetzen")}</button>
    </form>
    <div class="filter-dialog-fuss">
      <button type="button" class="btn btn-primaer btn-voll" data-filter-zeigen>{tp(lang, "liste.zeigen", gesamt)}</button>
    </div>
  </dialog>
  <p class="filter-fehler" data-filter-fehler role="status" hidden>{t(lang, "liste.filterFehler")}</p>
</div>

<style>
  .filter-leiste {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px 16px;
  }
  .filter-oeffnen {
    flex: 1 1 140px;
  }
  .filter-sort {
    flex: 1 1 180px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .filter-sort-label {
    font-size: 0.875rem;
    color: var(--color-schiefer);
  }
  .filter-inline:empty {
    display: none;
  }

  /* Mobil: Dialog von rechts, volle Höhe */
  .filter-dialog {
    width: min(100%, 480px);
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: var(--color-weiss);
    color: var(--color-tusche);
  }
  .filter-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .filter-dialog::backdrop {
    background: rgb(0 0 0 / 0.4);
  }
  .filter-dialog-kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px 12px 20px;
  }
  .filter-zu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: 0;
    cursor: pointer;
    color: inherit;
  }
  .filter-dialog .filter-form {
    flex: 1;
    overflow-y: auto;
    padding: 0 20px 20px;
  }
  .filter-dialog-fuss {
    padding: 16px 20px;
    background: var(--color-glas);
  }

  .filter-feld-kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 52px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .filter-feld-kopf::-webkit-details-marker {
    display: none;
  }
  .filter-feld :global(.filter-zu-icon),
  .filter-feld[open] :global(.filter-auf) {
    display: none;
  }
  .filter-feld[open] :global(.filter-zu-icon) {
    display: inline;
  }
  .filter-werte {
    padding: 0 0 12px;
  }
  .filter-werte[data-name="groesse"] {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    column-gap: 12px;
  }
  .filter-sale {
    margin-top: 8px;
    font-weight: 600;
  }
  .filter-reset {
    margin-top: 16px;
    min-height: 44px;
  }
  .filter-fehler {
    margin-top: 12px;
    color: var(--color-schiefer);
  }

  /* Ab 1024 px: Zeile mit aufklappbaren Feldern (das Formular liegt dann in .filter-inline) */
  @media (min-width: 1024px) {
    .filter-leiste {
      flex-wrap: nowrap;
      align-items: flex-end;
    }
    .filter-oeffnen {
      display: none;
    }
    .filter-inline {
      flex: 1;
      min-width: 0;
    }
    .filter-sort {
      flex: 0 0 220px;
    }
    .filter-inline .filter-form {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 12px;
    }
    .filter-inline .filter-feld {
      position: relative;
    }
    .filter-inline .filter-feld-kopf {
      padding: 0 14px;
      box-shadow: inset 0 0 0 var(--stroke) var(--color-schiefer);
      font-weight: 400;
    }
    .filter-inline .filter-feld[open] .filter-feld-kopf {
      box-shadow: inset 0 0 0 var(--stroke) var(--color-tusche);
    }
    .filter-inline .filter-werte {
      position: absolute;
      z-index: 20;
      top: calc(100% + 4px);
      left: 0;
      min-width: 240px;
      max-height: 360px;
      overflow-y: auto;
      padding: 8px 16px;
      background: var(--color-weiss);
      box-shadow: inset 0 0 0 var(--stroke) var(--color-tusche);
    }
    .filter-inline .filter-werte[data-name="groesse"] {
      min-width: 320px;
    }
    .filter-inline .filter-sale {
      margin: 0 4px;
      font-weight: 400;
    }
    .filter-inline .filter-reset {
      margin: 0 0 0 4px;
    }
  }
</style>
