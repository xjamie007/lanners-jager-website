{
  "name": "lanners-jager-ettelbruck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website und Shop für Confection Lanners und Jager-Oberlinkels, Grand-Rue Ettelbruck. Astro (statisch) + Supabase Edge Functions + SoftTouch.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run sync-shared && astro dev",
    "dev:api": "npm run sync-shared && deno task --config supabase/functions/deno.json dev",
    "demo": "npm run sync-shared && node scripts/demo.ts",
    "build": "npm run sync-shared && npm run check:i18n && astro build && pagefind --site dist && node scripts/check-seo.ts",
    "preview": "astro preview",
    "sync-shared": "node scripts/sync-shared.ts",
    "fixtures": "node scripts/build-fixtures.ts",
    "demo-fotos": "node scripts/build-demo-fotos.ts",
    "demo-fotos:aufbereiten": "python3 scripts/demo-fotos/aufbereiten.py",
    "check:i18n": "node scripts/check-i18n.ts",
    "check:shared": "node scripts/sync-shared.ts --check",
    "check:types": "astro sync && tsc --noEmit -p tsconfig.json",
    "check:functions": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "test": "node --test \"scripts/tests/*.test.ts\" && deno test --config supabase/functions/deno.json --allow-all supabase/functions/_shared/",
    "lb-review": "node scripts/lb-review.ts",
    "offene-punkte": "node scripts/offene-punkte.ts",
    "loadtest": "node scripts/generate-demo-catalog.ts --count 3000 && node scripts/loadtest-build.ts"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
